#!/bin/bash
# Gekko ADB Studio - selector de frontend (GTK 4 por defecto).
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="${GEKKO_ADB_PROJECT_DIR:-$(cd "$(dirname "$SELF")/.." >/dev/null 2>&1 && pwd)}"
PYTHON="${GEKKO_ADB_PYTHON:-python3}"
BACKEND="${GEKKO_ADB_GTK:-auto}"
BACKEND="${BACKEND,,}"
PRINT_BACKEND=false
CLI=false
ARGS=()

usage() {
    printf '%s\n' \
        'Uso: gekko-adb [--gtk4|--gtk3] [opción]' \
        '  --gtk4               Forzar frontend GTK 4' \
        '  --gtk3               Forzar frontend GTK 3' \
        '  --print-backend      Mostrar el frontend elegido (no abre la app)' \
        '  --diagnostics        Verificar dependencias y dispositivos (CLI, sin GTK)' \
        '  --json               Estado de conexión y dispositivos en JSON (CLI, sin GTK)' \
        '  --version            Mostrar versión' \
        '  --help, -h           Esta ayuda' \
        '' \
        'Variables: GEKKO_ADB_GTK=auto|gtk3|gtk4, GEKKO_ADB_PYTHON, GEKKO_ADB_PROJECT_DIR'
}

for arg in "$@"; do
    case "$arg" in
        --gtk3) BACKEND=gtk3 ;;
        --gtk4) BACKEND=gtk4 ;;
        --print-backend) PRINT_BACKEND=true ;;
        --diagnostics|--version|--json) CLI=true; ARGS+=("$arg") ;;
        --help|-h) usage; exit 0 ;;
        *)
            echo "ERROR: opción desconocida: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$BACKEND" in
    auto|gtk3|gtk4) ;;
    *)
        echo "ERROR: GEKKO_ADB_GTK debe ser auto, gtk3 o gtk4 (recibido: $BACKEND)" >&2
        exit 2
        ;;
esac

if ! command -v "$PYTHON" >/dev/null 2>&1; then
    echo "ERROR: no se encontró el intérprete '$PYTHON' (instala python o ajusta GEKKO_ADB_PYTHON)." >&2
    exit 1
fi

if [[ ! -f "$PROJECT_DIR/gekko_adb_core.py" ]]; then
    echo "ERROR: no se encontró gekko_adb_core.py en $PROJECT_DIR (revisa GEKKO_ADB_PROJECT_DIR)." >&2
    exit 1
fi

if $CLI; then
    exec "$PYTHON" "$PROJECT_DIR/gekko_adb_core.py" "${ARGS[@]}"
fi

have_gtk() {
    "$PYTHON" -c "import gi; gi.require_version('Gtk','$1'); from gi.repository import Gtk" >/dev/null 2>&1
}

if [[ "$BACKEND" == auto ]]; then
    if have_gtk 4.0; then
        BACKEND=gtk4
    elif have_gtk 3.0; then
        BACKEND=gtk3
    else
        echo "ERROR: ni GTK 4 ni GTK 3 disponibles para $PYTHON (instala python-gobject + gtk4/gtk3)." >&2
        exit 1
    fi
else
    ver=4.0; [[ "$BACKEND" == gtk3 ]] && ver=3.0
    if ! have_gtk "$ver"; then
        echo "ERROR: $BACKEND no está disponible para $PYTHON (instala python-gobject + ${BACKEND})." >&2
        exit 1
    fi
fi

if $PRINT_BACKEND; then
    echo "$BACKEND"
    exit 0
fi

case "$BACKEND" in
    gtk4) exec "$PYTHON" "$PROJECT_DIR/gekko-adb-gtk4.py" ;;
    gtk3) exec "$PYTHON" "$PROJECT_DIR/gekko-adb-gtk3.py" ;;
esac
